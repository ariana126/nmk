    "/api/password-resets/{token}/password": {
      "put": {
        "operationId": "PasswordResetController_reset",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "description": "The secret carried by the reset link",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed"
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "type": {
                      "type": "string",
                      "example": "https://my-api-doc.dev/problems/validation-error"
                    },
                    "title": {
                      "type": "string",
                      "example": "Validation Error"
                    },
                    "status": {
                      "type": "number",
                      "example": 400
                    },
                    "detail": {
                      "type": "string",
                      "example": "One or more fields failed validation."
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string",
                            "example": "email"
                          },
                          "message": {
                            "type": "string",
                            "example": "email must be an email"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "type": {
                      "type": "string",
                      "example": "https://my-api-doc.dev/problems/password-reset-not-found"
                    },
                    "title": {
                      "type": "string",
                      "example": "Password Reset Not Found"
                    },
                    "status": {
                      "type": "number",
                      "example": 404
                    },
                    "detail": {
                      "type": "string",
                      "example": "No password reset matches the link that was used"
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "type": {
                      "type": "string",
                      "example": "https://my-api-doc.dev/problems/password-reset-expired"
                    },
                    "title": {
                      "type": "string",
                      "example": "Password Reset Expired"
                    },
                    "status": {
                      "type": "number",
                      "example": 410
                    },
                    "detail": {
                      "type": "string",
                      "example": "Password reset link expired at 2026-01-01T11:00:00.000Z"
                    },
                    "expiredAt": {
                      "type": "string",
                      "example": "2026-01-01T11:00:00.000Z"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Choose a new password using a reset link",
        "tags": [
          "Password Resets"
        ]
      }
    }
