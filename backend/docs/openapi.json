                    },
                    "status": {
                      "type": "number",
                      "example": 404
                    },
                    "detail": {
                      "type": "string",
                      "example": "No user found with email john.doe@example.com"
                    },
                    "email": {
                      "type": "string",
                      "example": "john.doe@example.com"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Ask for a password reset link by email",
        "tags": [
          "Password Resets"
