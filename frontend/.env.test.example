# The test stack: the same app, on its own port, pointed at the backend's test stack.
# Everything not set here falls through to .env, which Compose reads first.

APP_PORT=4201

API_PROXY_TARGET=http://host.docker.internal:3001

# There is deliberately no NODE_ENV=test here. The backend needs it to mount its TestingModule;
# `ng serve` has nothing that switches on it, and setting it would only suggest otherwise. The
# two stacks differ by the port they publish and the backend they proxy to, and by nothing else.
