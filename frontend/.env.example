APP_PORT=4200

# Where the dev server forwards /api. See proxy.conf.mjs for why this is a proxy rather than a
# base URL compiled into the client. The test stack overrides it in .env.test to reach the
# backend's test stack instead; host.docker.internal is the host, where the backend publishes
# its ports — the two projects share no Docker network.
API_PROXY_TARGET=http://host.docker.internal:3000

# Where `make lint-accessibility` downloads Chromium from when it builds its image.
# Leave unset to use Playwright's own CDN — correct everywhere it is reachable, including CI.
# Playwright's CDN is geo-blocked in some regions and answers 403 "this service is not available
# in your location"; if the build fails that way, point this at a mirror of the same tree. The
# path is unchanged, only the host. Note a mirror is a third party in your supply chain — pick
# one you are willing to trust.
# PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
