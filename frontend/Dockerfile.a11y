# The accessibility audit's image: the same Node base as the dev server, plus Chromium.
#
# Not mcr.microsoft.com/playwright, which ships Chromium, Firefox and WebKit and weighs several
# times this — the audit drives one browser. Letting `playwright install` fetch it also means the
# browser always matches the installed @playwright/test, so there is no image tag to keep in step
# with package.json.
#
# It is a separate image from the dev server's so that only this one gate carries a browser:
# `make lint`, `make format` and `make run-unit-tests` keep cold-building the slim node image.
FROM node:24-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
# The install's own browser download would fetch every browser Playwright pins; skip it and let
# the next line fetch just the one, together with the system libraries Chromium needs.
RUN PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci

# Where the browser comes from. Empty means Playwright's own CDN, which is correct everywhere it
# is reachable — including CI. It is geo-blocked in some regions, though, answering 403 "this
# service is not available in your location", and a gate you cannot run locally is half a gate.
# Set PLAYWRIGHT_DOWNLOAD_HOST in frontend/.env to a mirror there; only the host changes, the
# URL path is identical. See .env.example and the accessibility section of CLAUDE.md.
ARG PLAYWRIGHT_DOWNLOAD_HOST=
RUN npx playwright install --with-deps chromium

COPY . .

CMD ["npm", "run", "lint:accessibility"]
