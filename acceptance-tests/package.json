{
  "name": "nmk-acceptance-tests",
  "version": "0.0.1",
  "description": "Black-box BDD acceptance tests, run against a live backend and frontend instance.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --env-file=.env node_modules/.bin/cucumber-js --tags 'not @wip'",
    "report": "serenity-bdd run --features-directory specs",
    "lint": "eslint \"{screenplay,step-definitions,support}/**/*.ts\"",
    "lint:fix": "eslint \"{screenplay,step-definitions,support}/**/*.ts\" --fix",
    "format": "prettier --check \"{screenplay,step-definitions,support}/**/*.ts\"",
    "format:fix": "prettier --write \"{screenplay,step-definitions,support}/**/*.ts\""
  },
  "overrides": {
    "@cucumber/gherkin": "42.0.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@eslint/js": "^9.18.0",
    "@serenity-js/assertions": "^3.44.1",
    "@serenity-js/console-reporter": "^3.44.1",
    "@serenity-js/core": "^3.44.1",
    "@serenity-js/cucumber": "^3.44.1",
    "@serenity-js/playwright": "^3.44.1",
    "@serenity-js/rest": "^3.44.1",
    "@serenity-js/serenity-bdd": "^3.44.1",
    "@serenity-js/web": "^3.44.1",
    "@types/node": "^24.12.3",
    "axios": "^1.18.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "playwright": "~1.61.1",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
