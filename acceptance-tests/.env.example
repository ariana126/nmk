API_BASE_URL="http://localhost:3001/api"
APP_BASE_URL="http://localhost:4201"

# Mirror for Playwright's browser download, used only at image build time. Leave it commented to
# use Playwright's own CDN, which is right for CI and most contributors. Uncomment if the build
# fails with `403 ... this service is not available in your location`.
# PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
